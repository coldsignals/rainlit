# https:// for your Rainlit (see docker-compose.yml). Caddy gets a free certificate for
# DOMAIN and renews it by itself.
{$DOMAIN} {
	encode gzip
	# LiveKit, for voice channels and group calls, if it runs here too: wss://DOMAIN/livekit
	handle_path /livekit/* {
		reverse_proxy livekit:7880
	}
	handle {
		reverse_proxy rainlit:3000
	}
}
