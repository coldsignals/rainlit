# Settings for your own Rainlit with Docker (see SELF-HOSTING.md). Copy this file to .env.

# Your Rainlit's address, without https:// (a domain or subdomain pointed at this machine).
DOMAIN=chat.example.com

# Optional: your Rainlit's name, shown on the sign-in page and in the apps.
SERVER_NAME=

# Recommended: a relay, so calls connect on every network (SELF-HOSTING.md, step 5).
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=

# Optional: GIFs (SELF-HOSTING.md, step 6).
KLIPY_API_KEY=

# Optional: the biggest file people can send, in MB (100 if left empty).
MAX_FILE_MB=
