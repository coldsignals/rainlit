# Settings for your own Rainlit with Docker (see SELF-HOSTING.md). Copy this file to .env.

# Your Rainlit's address, without https:// (a domain or subdomain pointed at this machine).
DOMAIN=chat.example.com

# Optional: your Rainlit's name, shown on the sign-in page and in the apps.
SERVER_NAME=

# Recommended: a relay, so calls connect on every network (SELF-HOSTING.md, step 5).
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=

# Optional: GIFs (SELF-HOSTING.md, step 6).
KLIPY_API_KEY=

# Optional: voice channels and group calls, through LiveKit (SELF-HOSTING.md, step 11).
# With LiveKit Cloud, fill in its three settings. To run LiveKit here too instead, set:
#   COMPOSE_PROFILES=voice
#   LIVEKIT_URL=wss://chat.example.com/livekit   (your DOMAIN, then /livekit)
#   LIVEKIT_API_URL=http://livekit:7880
#   LIVEKIT_API_KEY=rainlit
#   LIVEKIT_API_SECRET=   (make one up: 32 characters or more, e.g. from openssl rand -hex 24)
# and let TCP 7881 and UDP 7882 through to this machine.
COMPOSE_PROFILES=
LIVEKIT_URL=
LIVEKIT_API_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional: the biggest file people can send, in MB (100 if left empty).
MAX_FILE_MB=
